{
  "manifest_version": 3,
  "name": "ClipBrief AI",
  "version": "1.1",
  "description": "Extract YouTube transcripts from the current video page and send them to ClipBrief AI for summary and source checks.",
  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "clipboardWrite",
    "storage"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://youtube.com/*",
    "https://*.onrender.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://youtube-summarize-0oms.onrender.com/*",
    "https://youtube-summarize-bridge.onrender.com/*",
    "https://*.trycloudflare.com/*",
    "https://*.ngrok-free.app/*",
    "https://*.ngrok.app/*",
    "https://*.workers.dev/*"
  ],
  "icons": {
    "16": "icons/icon_16.png",
    "32": "icons/icon_32.png",
    "48": "icons/icon_48.png",
    "128": "icons/icon_128.png"
  },
  "action": {
    "default_title": "ClipBrief AI",
    "default_icon": {
      "16": "icons/icon_16.png",
      "32": "icons/icon_32.png",
      "48": "icons/icon_48.png"
    },
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*",
        "https://*.onrender.com/*",
        "http://127.0.0.1/*",
        "http://localhost/*",
        "https://youtube-summarize-0oms.onrender.com/*",
        "https://youtube-summarize-bridge.onrender.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}
